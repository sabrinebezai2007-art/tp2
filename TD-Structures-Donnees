// ===================== EXERCICE 1 : POINT =====================

typedef struct {
    int x;
    int y;
} Point;

// Saisir un point
Point SaisirPoint() {
    Point p;
    printf("Donner les coordonnees du point (x y) : ");
    scanf("%d %d", &p.x, &p.y);
    return p;
}

// Afficher un point
void AfficherPoint(Point p) {
    printf("(%d, %d)\n", p.x, p.y);
}

// Distance par rapport à l'origine (passage par valeur)
double DistanceOrigineValeur(Point p) {
    return sqrt(p.x * p.x + p.y * p.y);
}

// Distance par rapport à l'origine (passage par adresse)
double DistanceOrigineAdresse(Point *p) {
    return sqrt(p->x * p->x + p->y * p->y);
}

// Trier un tableau de points par distance croissante
void TrierPoints(Point T[], int taille) {
    int i, j;
    Point temp;
    for(i = 0; i < taille - 1; i++) {
        for(j = i + 1; j < taille; j++) {
            if(DistanceOrigineValeur(T[i]) > DistanceOrigineValeur(T[j])) {
                temp = T[i];
                T[i] = T[j];
                T[j] = temp;
            }
        }
    }
}

// ===================== EXERCICE 2 : HEURE =====================

typedef struct {
    int hh;
    int mm;
    int ss;
} Heure;

// Heure -> secondes
int HeureEnSecondes(Heure h) {
    return h.hh * 3600 + h.mm * 60 + h.ss;
}

// Secondes -> Heure
Heure SecondesEnHeure(int sec) {
    Heure h;
    h.hh = sec / 3600;
    sec = sec % 3600;
    h.mm = sec / 60;
    h.ss = sec % 60;
    return h;
}

// Addition de deux heures
Heure AddHeures(Heure h1, Heure h2) {
    int total = HeureEnSecondes(h1) + HeureEnSecondes(h2);
    return SecondesEnHeure(total);
}

// Différence entre deux heures (temps écoulé)
Heure DifferenceHeures(Heure h1, Heure h2) {
    int diff = abs(HeureEnSecondes(h1) - HeureEnSecondes(h2));
    return SecondesEnHeure(diff);
}

