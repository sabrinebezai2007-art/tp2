// ===================== LISTES CHAÎNÉES =====================

typedef struct Element {
    int val;
    struct Element *suivant;
} Element, *Liste;

// Créer un nouvel élément
Element* CreerElement(int valeur) {
    Element *e = (Element*)malloc(sizeof(Element));
    if(e == NULL) return NULL;
    e->val = valeur;
    e->suivant = NULL;
    return e;
}

// Insérer en tête - Complexité : O(1)
int InsererEnTete(Liste *L, int valeur) {
    Element *e = CreerElement(valeur);
    if(e == NULL) return 0;
    e->suivant = *L;
    *L = e;
    return 1;
}

// Insérer en fin - Complexité : O(n)
int InsererEnFin(Liste *L, int valeur) {
    Element *e = CreerElement(valeur);
    if(e == NULL) return 0;
    if(*L == NULL) {
        *L = e;
        return 1;
    }
    Element *ptr = *L;
    while(ptr->suivant != NULL)
        ptr = ptr->suivant;
    ptr->suivant = e;
    return 1;
}

// Rechercher une valeur - Complexité : O(n)
int Rechercher(Liste L, int valeur) {
    Element *ptr = L;
    while(ptr != NULL) {
        if(ptr->val == valeur)
            return 1;
        ptr = ptr->suivant;
    }
    return 0;
}

// Supprimer la valeur minimum - Complexité : O(n)
int SupprimerMinimum(Liste *L) {
    if(*L == NULL) return 0;
    
    Element *ptr = *L;
    Element *pMin = NULL;
    Element *precMin = NULL;
    Element *prec = NULL;
    int min = ptr->val;
    
    // Trouver le minimum
    while(ptr != NULL) {
        if(ptr->val < min) {
            min = ptr->val;
            pMin = ptr;
            precMin = prec;
        }
        prec = ptr;
        ptr = ptr->suivant;
    }
    
    // Supprimer le minimum
    if(pMin == *L) {
        *L = (*L)->suivant;
    } else {
        precMin->suivant = pMin->suivant;
    }
    free(pMin);
    return 1;
}

// Fusion de deux listes en alternance - Complexité : O(n+m)
Liste FusionAlternance(Liste L1, Liste L2) {
    Liste resultat = NULL;
    Element *ptr1 = L1, *ptr2 = L2;
    
    while(ptr1 != NULL && ptr2 != NULL) {
        InsererEnFin(&resultat, ptr1->val);
        InsererEnFin(&resultat, ptr2->val);
        ptr1 = ptr1->suivant;
        ptr2 = ptr2->suivant;
    }
    
    while(ptr1 != NULL) {
        InsererEnFin(&resultat, ptr1->val);
        ptr1 = ptr1->suivant;
    }
    
    while(ptr2 != NULL) {
        InsererEnFin(&resultat, ptr2->val);
        ptr2 = ptr2->suivant;
    }
    
    return resultat;
}

// Détruire une liste - Complexité : O(n)
void DetruireListe(Liste *L) {
    Element *ptr;
    while(*L != NULL) {
        ptr = *L;
        *L = (*L)->suivant;
        free(ptr);
    }
}

// Afficher une liste - Complexité : O(n)
void AfficherListe(Liste L) {
    Element *ptr = L;
    while(ptr != NULL) {
        printf("%d -> ", ptr->val);
        ptr = ptr->suivant;
    }
    printf("NULL\n");
}

// Créer une liste de n entiers aléatoires - Complexité : O(n)
Liste CreerListeAleatoire(int n) {
    Liste L = NULL;
    for(int i = 0; i < n; i++) {
        InsererEnTete(&L, rand() % 101); // entre 0 et 100
    }
    return L;
}

// ===================== PILES (STACK) =====================

typedef struct PileNode {
    int data;
    struct PileNode *next;
} PileNode, *Pile;

// Empiler - Complexité : O(1)
void Push(Pile *p, int value) {
    PileNode *newNode = (PileNode*)malloc(sizeof(PileNode));
    if(newNode == NULL) return;
    newNode->data = value;
    newNode->next = *p;
    *p = newNode;
}

// Dépiler - Complexité : O(1)
int Pop(Pile *p) {
    if(*p == NULL) {
        printf("Pile vide !\n");
        return -1;
    }
    PileNode *top = *p;
    int value = top->data;
    *p = top->next;
    free(top);
    return value;
}

// Vérifier si la pile est vide
int PileVide(Pile p) {
    return p == NULL;
}

// ===================== FILES (QUEUE) =====================

typedef struct FileNode {
    char data;
    struct FileNode *next;
} FileNode;

typedef struct {
    FileNode *first;
    FileNode *last;
} File;

// Initialiser une file
void InitFile(File *q) {
    q->first = NULL;
    q->last = NULL;
}

// Enfiler - Complexité : O(1)
int Enqueue(File *q, char value) {
    FileNode *newNode = (FileNode*)malloc(sizeof(FileNode));
    if(newNode == NULL) return 0;
    newNode->data = value;
    newNode->next = NULL;
    
    if(q->first == NULL) {
        q->first = q->last = newNode;
    } else {
        q->last->next = newNode;
        q->last = newNode;
    }
    return 1;
}

// Défiler - Complexité : O(1)
int Dequeue(File *q, char *value) {
    if(q->first == NULL) return 0;
    FileNode *tmp = q->first;
    *value = tmp->data;
    q->first = tmp->next;
    if(q->first == NULL)
        q->last = NULL;
    free(tmp);
    return 1;
}

// Vérifier si une chaîne est un palindrome
int EstPalindrome(char chaine[]) {
    int longueur = 0;
    while(chaine[longueur] != '\0') longueur++;
    
    Pile p = NULL;
    File q;
    InitFile(&q);
    
    // Remplir pile et file
    for(int i = 0; i < longueur; i++) {
        Push(&p, chaine[i]);
        Enqueue(&q, chaine[i]);
    }
    
    // Comparer
    for(int i = 0; i < longueur; i++) {
        if(Pop(&p) != (Dequeue(&q, &chaine[0]) ? chaine[0] : 0))
            return 0;
    }
    return 1;
}

