    // 6. Construire une liste triée à partir de l'arbre
    Liste LT = NULL;
    ArbreVersListeTriee(A, &LT);
    printf("\nListe triée issue de l'arbre :\n");
    AfficherListe(LT);
    
    // 7. Créer une liste non triée et la trier
    Liste L = NULL;
    printf("\nCréation d'une liste non triée de 10 entiers aléatoires :\n");
    for(int i = 0; i < 10; i++) {
        int val = rand() % 50;
        printf("%d ", val);
        ListNode *newNode = (ListNode*)malloc(sizeof(ListNode));
        newNode->val = val;
        newNode->suivant = L;
        L = newNode;
    }
    printf("\nListe non triée :\n");
    AfficherListe(L);
    
    Liste LTrie = TrierListe(L);
    printf("Liste triée :\n");
    AfficherListe(LTrie);
    
    // Nettoyage
    DetruireArbre(A);
    DetruireListe(&LT);
    DetruireListe(&L);
    DetruireListe(&LTrie);
    
    printf("\n========== RÉSUMÉ DES COMPLEXITÉS ==========\n");
    printf("Insertion : O(log n) à O(n)\n");
    printf("Recherche : O(log n) à O(n)\n");
    printf("Comptage occurrences : O(n)\n");
    printf("Parcours infixe : O(n)\n");
    printf("Plus petit/grand élément : O(log n) à O(n)\n");
    printf("Liste triée depuis arbre : O(n)\n");
    printf("Arbre depuis liste : O(n log n)\n");
    
    return 0;
}



