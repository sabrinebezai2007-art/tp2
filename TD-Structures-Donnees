// Complexité : O(n)

int IndiceMinimum(int tab[], int N) {
    int index = 0;
    for(int i = 1; i < N; i++) {
        if(tab[i] < tab[index])
            index = i;
    }
    return index;
}

// ===================== EXERCICE 2 : MINIMAX =====================
// Complexité : O(n × m)

#define LIGNES 3
#define COLONNES 3

int MiniMax(int matrice[LIGNES][COLONNES]) {
    int i, j;
    int max_ligne;
    int minimax;
    
    for(i = 0; i < LIGNES; i++) {
        max_ligne = matrice[i][0];
        for(j = 1; j < COLONNES; j++) {
            if(matrice[i][j] > max_ligne)
                max_ligne = matrice[i][j];
        }
        if(i == 0)
            minimax = max_ligne;
        else if(max_ligne < minimax)
            minimax = max_ligne;
    }
    return minimax;
}

// ===================== EXERCICE 3 : RÉCURSIVITÉ =====================

// Puissance classique - Complexité : O(n)
int PuissanceClassique(int a, int n) {
    if(n == 0)
        return 1;
    return a * PuissanceClassique(a, n - 1);
}

// Exponentiation rapide - Complexité : O(log n)
int PuissanceRapide(int a, int n) {
    if(n == 0)
        return 1;
    if(n % 2 == 0)
        return PuissanceRapide(a, n/2) * PuissanceRapide(a, n/2);
    else
        return a * PuissanceRapide(a, n/2) * PuissanceRapide(a, n/2);
}

// Somme des puissances - Complexité : O(n²)
int SommePuissances(int a, int n) {
    if(n == 0)
        return 1;
    return PuissanceClassique(a, n) + SommePuissances(a, n - 1);
}

// ===================== EXERCICE 4 : ANALYSE DE COMPLEXITÉ =====================

// rec1 : calcule 2^n - Complexité : O(n)
int rec1(int n) {
    if(n == 0)
        return 1;
    return 2 * rec1(n - 1);
}

// rec2 : calcule 2^n - Complexité : O(2^n)
int rec2(int n) {
    if(n == 0)
        return 1;
    return rec2(n - 1) + rec2(n - 1);
}

