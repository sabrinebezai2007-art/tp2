// ===================== STRUCTURE DE L'ARBRE =====================

typedef int element_type;

typedef struct tree_node {
    element_type element;
    struct tree_node *left;
    struct tree_node *right;
} tree_node, *SEARCH_TREE;

// ===================== 1. INSERTION =====================
// Complexité : O(log n) à O(n)

SEARCH_TREE Insert(element_type x, SEARCH_TREE T) {
    if(T == NULL) {
        T = (SEARCH_TREE)malloc(sizeof(tree_node));
        if(T == NULL) {
            printf("Erreur d'allocation mémoire\n");
            exit(0);
        }
        T->element = x;
        T->left = T->right = NULL;
    }
    else if(x < T->element)
        T->left = Insert(x, T->left);
    else if(x > T->element)
        T->right = Insert(x, T->right);
    // Si x == T->element, on ne fait rien (pas de doublon)
    
    return T;
}

// ===================== 2. RECHERCHE =====================
// Complexité : O(log n) à O(n)

SEARCH_TREE Rechercher(SEARCH_TREE T, element_type e) {
    if(T == NULL)
        return NULL;
    if(e == T->element)
        return T;
    else if(e < T->element)
        return Rechercher(T->left, e);
    else
        return Rechercher(T->right, e);
}

// ===================== 3. COMPTER LES OCCURRENCES =====================
// Complexité : O(n)

int CompterOccurrences(SEARCH_TREE T, element_type e) {
    int count = 0;
    if(T != NULL) {
        count += CompterOccurrences(T->left, e);
        if(T->element == e)
            count++;
        count += CompterOccurrences(T->right, e);
    }
    return count;
}

// ===================== 4. PARCOURS INFIXÉ =====================
// Complexité : O(n)

void ParcoursInfixe(SEARCH_TREE T) {
    if(T != NULL) {
        ParcoursInfixe(T->left);
        printf("%d ", T->element);
        ParcoursInfixe(T->right);
    }
}

// ===================== 5. PLUS PETIT ÉLÉMENT =====================
// Complexité : O(log n) à O(n)

element_type PlusPetitElement(SEARCH_TREE T) {
    if(T == NULL) {
        printf("Arbre vide !\n");
        return -1;
    }
    while(T->left != NULL)
        T = T->left;
    return T->element;
}

// ===================== 6. PLUS GRAND ÉLÉMENT =====================
// Complexité : O(log n) à O(n)

element_type PlusGrandElement(SEARCH_TREE T) {
    if(T == NULL) {
        printf("Arbre vide !\n");
        return -1;
    }
    while(T->right != NULL)
        T = T->right;
    return T->element;
}

// ===================== 7. VÉRIFIER SI C'EST UN ABR =====================
// Complexité : O(n)

int EstABR(SEARCH_TREE T) {
    if(T == NULL)
        return 1;
    if(T->left != NULL && PlusGrandElement(T->left) >= T->element)
        return 0;
    if(T->right != NULL && PlusPetitElement(T->right) <= T->element)
        return 0;
    return EstABR(T->left) && EstABR(T->right);
}

// ===================== 8. CONSTRUIRE LISTE TRIÉE =====================
// Complexité : O(n)

typedef struct ListNode {
    element_type val;
    struct ListNode *suivant;
} ListNode, *Liste;

void InsererListeFin(Liste *L, element_type val) {
    ListNode *newNode = (ListNode*)malloc(sizeof(ListNode));
    newNode->val = val;
    newNode->suivant = NULL;
    
    if(*L == NULL) {
        *L = newNode;
        return;
    }
    
    ListNode *ptr = *L;
    while(ptr->suivant != NULL)
        ptr = ptr->suivant;
    ptr->suivant = newNode;
}

void ArbreVersListeTriee(SEARCH_TREE T, Liste *L) {
    if(T != NULL) {
        ArbreVersListeTriee(T->left, L);
        InsererListeFin(L, T->element);
        ArbreVersListeTriee(T->right, L);
    }
}

void AfficherListe(Liste L) {
    ListNode *ptr = L;
    while(ptr != NULL) {
        printf("%d -> ", ptr->val);
        ptr = ptr->suivant;
    }
    printf("NULL\n");
}

void DetruireListe(Liste *L) {
    ListNode *ptr;
    while(*L != NULL) {
        ptr = *L;
        *L = (*L)->suivant;
        free(ptr);
    }
}

// ===================== 9. CONSTRUIRE ABR À PARTIR D'UNE LISTE =====================
// Complexité : O(n log n)

SEARCH_TREE ArbreDepuisListe(Liste L) {
    SEARCH_TREE T = NULL;
    ListNode *ptr = L;
    while(ptr != NULL) {
        T = Insert(ptr->val, T);
        ptr = ptr->suivant;
    }
    return T;
}

// ===================== 10. TRIER UNE LISTE =====================
// Complexité : O(n log n)

Liste TrierListe(Liste L) {
    SEARCH_TREE T = ArbreDepuisListe(L);
    Liste resultat = NULL;
    ArbreVersListeTriee(T, &resultat);
    DetruireArbre(T);
    return resultat;
}

// ===================== DÉTRUIRE L'ARBRE =====================
// Complexité : O(n)

void DetruireArbre(SEARCH_TREE T) {
    if(T != NULL) {
        DetruireArbre(T->left);
        DetruireArbre(T->right);
        free(T);
    }
}

// ===================== AFFICHER ARBRE (avec indentation) =====================

void AfficherArbre(SEARCH_TREE T, int niveau) {
    if(T != NULL) {
        AfficherArbre(T->right, niveau + 1);
        for(int i = 0; i < niveau; i++)
            printf("    ");
        printf("%d\n", T->element);
        AfficherArbre(T->left, niveau + 1);
    }
}

